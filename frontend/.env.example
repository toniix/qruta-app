# Frontend - variables de entorno de desarrollo
# Copia este archivo a .env.local y ajusta lo que necesites.
# (.env.local está en .gitignore, así que tu key nunca se sube a git)

# ------------------------------------------------------------------
# API backend
# ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_MOCK=false

# ------------------------------------------------------------------
# Basemap del mapa (las imágenes de fondo que dibuja Leaflet)
# ------------------------------------------------------------------
# CARTO exige API key en sus tiles raster (PNG) desde el 25/09/2026.
# Sin key, el servidor devuelve un PNG en blanco rotulado "API KEY REQUIRED".
#
# Consigue una gratis (no necesitas cuenta) en: https://carto.com/basemaps/apikey
# Te llega por email en ~1 minuto.
VITE_CARTO_KEY=

# Estilo del basemap. Opciones: light_all | dark_all | rastertiles/voyager |
# rastertiles/voyager_nolabels | rastertiles/voyager_labels_under
VITE_CARTO_STYLE=light_all

# Zoom máximo del estilo raster.
VITE_CARTO_MAX_ZOOM=19

# Nota: los términos de CARTO exigen mantener la atribución visible
# (© OpenStreetMap contributors © CARTO). Está en el código del mapa, no la quites.
# Tras pegar la key, reinicia `pnpm dev` y haz hard-refresh (Ctrl+Shift+R):
# el navegador cachea los tiles.
