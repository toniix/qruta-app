# Plantilla de Variables de Entorno (se sube a Git — NUNCA pongas secretos reales acá).
# Local: copia a .env y completa. Prod: define estas mismas en el servidor/contenedor.
DB_URL=jdbc:postgresql://localhost:5432/rutas
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_aqui

# JWT: mínimo 32 bytes aleatorios. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generar_uno_de_al_menos_32_bytes_aleatorios
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Perfil Spring: local | prod. Prod además activa ddl-auto=validate, Flyway y apaga el seed.
SPRING_PROFILES_ACTIVE=local
JPA_DDL_AUTO=update
# Logging de SQL: apagado por defecto, es costoso y no debe viajar a un deploy.
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
FLYWAY_ENABLED=false

# Seed de desarrollo. Se activa SOLO con APP_SEED_ENABLED=true; el perfil
# activo no lo activa. Dejalo en false fuera de desarrollo.
ADMIN_SEED_EMAIL=admin@rutasya.pe
# Contraseña del admin inicial. Sin valor no se crea ningún admin: el arranque
# solo registra un warning. Obligatoria para sembrar una base nueva.
# ADMIN_SEED_PASSWORD=cambia_esto_en_local
APP_SEED_ENABLED=false

# Supabase Storage (imágenes de paraderos).
# Si SUPABASE_URL o SUPABASE_SERVICE_KEY quedan vacíos, la función de imágenes
# se deshabilita y el endpoint responde 503. El service key es un secreto real:
# nunca lo commitees, solo va en .env o en el entorno del servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=stop-images

GOOGLE_MAPS_API_KEY=
GEOCODE_DAILY_QUOTA=1000
