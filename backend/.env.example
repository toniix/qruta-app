# Plantilla de Variables de Entorno (se sube a Git — NUNCA pongas secretos reales acá).
# Local: copia a .env y completa. Prod: define estas mismas en el servidor/contenedor.
DB_URL=jdbc:postgresql://localhost:5432/rutas
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_aqui

# JWT: mínimo 32 bytes aleatorios. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generar_uno_de_al_menos_32_bytes_aleatorios
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Perfil Spring: local | prod. Prod además activa ddl-auto=validate, Flyway y apaga el seed.
SPRING_PROFILES_ACTIVE=local
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false

# Seed de desarrollo (solo con app.seed.enabled=true, i.e. perfil local).
# Descomenta y completa para fijar la contraseña del admin inicial;
# comentado/vacío = no se crea ningún admin. En local el default es admin123.
ADMIN_SEED_EMAIL=admin@rutasya.pe
# ADMIN_SEED_PASSWORD=cambia_esto_en_local
APP_SEED_ENABLED=false

GOOGLE_MAPS_API_KEY=
GEOCODE_DAILY_QUOTA=1000
